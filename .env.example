NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Notificaciones push (npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Opcional: contacto del remitente (mailto:tu@correo.com o https://tu-dominio). Por defecto, la URL de Vercel.
VAPID_SUBJECT=
# Solo para los recordatorios programados (ruta /api/push/reminders): nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
CRON_SECRET=
